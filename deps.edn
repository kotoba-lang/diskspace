{:paths ["src-host"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/kotoba {:git/url "https://github.com/kotoba-lang/kotoba.git"
                                     :git/sha "be20daa161a7ab19ec3f5a13b98a281f5ddd42c1"}}
 :aliases
 {:run {:main-opts ["-m" "kotoba.lang.diskspace.host"]}
  :check {:main-opts ["-m" "kotoba.lang.diskspace.host" "--check"]}
  :test {:extra-paths ["test"]
         :main-opts ["-m" "kotoba.lang.diskspace.test-runner"]}}}